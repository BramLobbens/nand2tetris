// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/05/CPU.hdl

/**
 * The Hack CPU (Central Processing unit), consisting of an ALU,
 * two registers named A and D, and a program counter named PC.
 * The CPU is designed to fetch and execute instructions written in
 * the Hack machine language. In particular, functions as follows:
 * Executes the inputted instruction according to the Hack machine
 * language specification. The D and A in the language specification
 * refer to CPU-resident registers, while M refers to the external
 * memory location addressed by A, i.e. to Memory[A]. The inM input
 * holds the value of this location. If the current instruction needs
 * to write a value to M, the value is placed in outM, the address
 * of the target location is placed in the addressM output, and the
 * writeM control bit is asserted. (When writeM==0, any value may
 * appear in outM). The outM and writeM outputs are combinational:
 * they are affected instantaneously by the execution of the current
 * instruction. The addressM and pc outputs are clocked: although they
 * are affected by the execution of the current instruction, they commit
 * to their new values only in the next time step. If reset==1 then the
 * CPU jumps to address 0 (i.e. pc is set to 0 in next time step) rather
 * than to the address resulting from executing the current instruction.
 */

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Put your code here:

    ///
    /// Decode for A-, or C-instruction
    ///
    // A-instruction: instruction[15] == 0
    Not(in=instruction[15], out=isAInstruction);
    And(a=instruction[15], b=true, out=isCInstruction);

    // Determine whether the instruction is an A-instruction
    Mux16(a=aluOut, b=instruction, sel=isAInstruction, out=aRegisterInput);

    // In case of a C-instruction:
    // Check the dest bits of the instruction to determine whether to load the A, D, or M.
    // d1, d2, d3 are the destination bits of the instruction.
    And(a=isCInstruction, b=instruction[5], out=destA);
    And(a=isCInstruction, b=instruction[4], out=destD);
    And(a=isCInstruction, b=instruction[3], out=destM);

    And(a=destM, b=true, out=writeM); // writeM is true if the instruction is a C-instruction and the dest bit for M is set.

    // Determine we have to load A; whether the instruction is an A-instruction or a C-instruction with a dest to A.
    Or(a=isAInstruction, b=destA, out=loadA);

    // Register A
    ARegister(
        in=aRegisterInput,
        load=loadA,
        out=aRegisterOut,
        out[0..14]=addressM
    );

    // Determine A/M input for ALU
    // the a-bit of the instruction determines whether to use A or M as the ALU input.
    Mux16(a=aRegisterOut, b=inM, sel=instruction[12], out=maOut);

    // Register D
    And(a=destD, b=isCInstruction, out=loadD);
    DRegister(in=aluOut, load=loadD, out=dRegisterOut);

    // ALU
    // pass the comp fields of the instruction to the ALU to determine the operation to perform.
    // bits [6..11] of the instruction are the comp bits.
    ALU(
        // OUT
        out=aluOut, // Note outM is also routed/wired back to internal inputs as well.
        zr=zr,
        ng=ng,

        //DATA
        // These are the ALU data inputs, which are either the D register or the A/M input.
        x=dRegisterOut,
        y=maOut,

        // CONTROL
        // These are the ALU control bits, which are determined by the instruction's comp field.
        zx=instruction[11], // c1
        nx=instruction[10], // c2
        zy=instruction[9], // c3
        ny=instruction[8], // c4
        f=instruction[7], // c5
        no=instruction[6] // c6
    );

    // Check the jump bits of a C-instruction to determine whether to load the PC register.
    // Note: after implementing a solution, I realise this can be simplified a lot.
    DMux8Way(
        in=isCInstruction,
        sel=instruction[0..2], // j1, j2, j3
        a=loadPC00, // 000 - no jump
        b=loadPC01, // 001 - JGT
        c=loadPC02, // 010 - JEQ
        d=loadPC03, // 011 - JGE
        e=loadPC04, // 100 - JLT
        f=loadPC05, // 101 - JNE
        g=loadPC06, // 110 - JLE
        h=loadPC07 // 111 - JMP
    );

    And(a=zr, b=true, out=isZero);
    And(a=ng, b=true, out=isNegative);
    Or(a=zr, b=ng, out=zrng); // zr or ng
    Not(in=zrng, out=isPositive); // not (zr or ng) = positive

    // Let's check if the ALU output satisfies the jump condition.
    And(a=loadPC01, b=isPositive, out=jumpGt); // JGT

    And(a=loadPC02, b=isZero, out=jumpEq); // JEQ

    And(a=loadPC03, b=isZero, out=pc03IsZero); // JGE
    And(a=loadPC03, b=isPositive, out=pc03IsPositive); // JGE
    Or(a=pc03IsZero, b=pc03IsPositive, out=jumpGe); // JGE

    And(a=loadPC04, b=isNegative, out=jumpLt); // JLT

    Not(in=isZero, out=isNotZero);
    And(a=loadPC05, b=isNotZero, out=jumpNe); // JNE

    And(a=loadPC06, b=isZero, out=pc06IsZero); // JLE
    And(a=loadPC06, b=isNegative, out=pc06IsNegative); // JLE
    Or(a=pc06IsZero, b=pc06IsNegative, out=jumpLe); // JLE

    And(a=loadPC07, b=true, out=jumpJmp); // JMP - unconditional jump

    // PC
    // PCOut is the address of the next instruction to execute.

    // Determine whether to jump (and load the PC with the A register value) or not.
    Or(a=jumpGt, b=jumpEq, out=or01);
    Or(a=or01, b=jumpGe, out=or02);
    Or(a=or02, b=jumpLt, out=or03);
    Or(a=or03, b=jumpNe, out=or04);
    Or(a=or04, b=jumpLe, out=or05);
    Or(a=or05, b=jumpJmp, out=jumpOut);

    // Determine whether to increment the PC or not.
    // If A-instruction or C-instruction with no jump, increment PC.
    Not(in=jumpOut, out=notJump);
    Or(a=isAInstruction, b=notJump, out=shouldIncrementPC);

    // If load, PC is set to aRegisterOut
    // if increment, PC is set to PC + 1
    // if reset, PC is set to 0
    // else return PC
    PC(in=aRegisterOut, load=jumpOut, inc=shouldIncrementPC, reset=reset, out[0..14]=pc);

    And16(a=aluOut, b=true, out=outM); // Because we cannot set the ALU output directly to outM if other internal parts depend on it.
}